APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/zhishu.db
# Generate a persistent production key: py -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# DATA_ENCRYPTION_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER=openai
# Explicitly opt in only when connecting to a trusted local/private model host.
AI_ALLOW_PRIVATE_HOSTS=false
# Clash 虚拟地址兼容：精确域名列表，仅 HTTPS 标准端口；服务端默认关闭。
AI_FAKE_IP_HOSTS=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000
# 公网 AI Horde 兜底：新用户未配置模型且无服务器环境模型时，默认使用（无需 API key）。
AI_HORDE_ENABLED=true
AI_HORDE_BASE_URL=https://aihorde.net
# AI_HORDE_MODEL=  （留空 = 使用任意可用模型）
# AI_HORDE_API_KEY=0000000000  （匿名）
AI_HORDE_TIMEOUT_MS=300000
# AI_ALLOWED_HOSTS=api.openai.com
# WEB_DIST=apps/web/dist
AI_ALLOWED_HOSTS=

# =============================================================================
# 邮箱注册 / 登录的 SMTP 配置（生产部署填写）
# =============================================================================
# 本地开发不需要填写——后端自动走 ConsoleSender，把验证码打到 stdout，
# 前端 dev 模式有「自动填充验证码」按钮。
# 部署时填上下列 5 个变量，后端会自动切换到 SmtpSender 真发邮件：
#
# 阿里云 DirectMail：
#   SMTP_HOST=smtpdm.aliyun.com   SMTP_PORT=465   SMTP_USER=noreply@your-domain.com
#   SMTP_PASS=<DirectMail授权码>   SMTP_FROM=noreply@your-domain.com
#
# 腾讯云 SES：
#   SMTP_HOST=smtp.qcloudmail.com  SMTP_PORT=465   SMTP_USER=noreply@your-domain.com
#   SMTP_PASS=<SES SMTP 授权码>    SMTP_FROM=noreply@your-domain.com
#
# Resend（Vercel / Railway / Fly.io 海外部署）：
#   SMTP_HOST=smtp.resend.com     SMTP_PORT=465   SMTP_USER=resend
#   SMTP_PASS=<Resend API key, re_*>  SMTP_FROM=noreply@your-domain.com
#
# SMTP_SSL=1 用 SSL/TLS 直连；SMTP_PORT=25 时改 0 走 STARTTLS。
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SSL=1
